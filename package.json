{
  "name": "dsh-mcp-panel",
  "version": "0.6.0",
  "description": "MCP 管理面板：每个服务器四档曝光（原生注入 / 仅名称 / 隐藏 / 关闭）+ 按 agent 预设做运行时隔离；隐藏的 MCP 由 mcp_search/mcp_call 按需调用。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "setup": "node scripts/setup-dsh-deps.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.2-rc.1"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilyblessing/dsh-mcp-panel.git"
  },
  "homepage": "https://github.com/lilyblessing/dsh-mcp-panel#readme",
  "bugs": {
    "url": "https://github.com/lilyblessing/dsh-mcp-panel/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "mcp",
    "panel",
    "agent"
  ]
}
