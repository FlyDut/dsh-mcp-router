{
  "name": "dsh-mcp-router",
  "version": "1.0.0",
  "description": "MCP 按需调用的路由",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlyDut/dsh-mcp-router.git"
  },
  "homepage": "https://github.com/FlyDut/dsh-mcp-router#readme",
  "bugs": {
    "url": "https://github.com/FlyDut/dsh-mcp-router/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "setup": "node scripts/setup-dsh-deps.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "selftest:exposure": "node scripts/selftest-exposure.mjs",
    "selftest:composition": "node scripts/selftest-composition-file.mjs",
    "selftest:import": "node scripts/selftest-external-import.mjs",
    "selftest:policy": "node scripts/selftest-policy.mjs",
    "selftest:edit": "node scripts/selftest-mcp-edit.mjs",
    "selftest:mcp": "node scripts/selftest-mcp.mjs",
    "selftest": "pnpm run selftest:exposure && pnpm run selftest:composition && pnpm run selftest:import && pnpm run selftest:policy && pnpm run selftest:edit && pnpm run selftest:mcp && pnpm run selftest:runtime && pnpm run selftest:assembly",
    "prepublishOnly": "pnpm run build && pnpm run verify && pnpm run selftest",
    "selftest:runtime": "node scripts/selftest-runtime.mjs",
    "selftest:assembly": "node scripts/selftest-assembly.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "mcp",
    "panel",
    "agent"
  ]
}
